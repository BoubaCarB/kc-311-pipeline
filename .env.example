# Copy to .env for local runs. .env is gitignored; in GitHub Actions
# these same names come from repository secrets instead.

# --- Data source (public, no key required for modest use) ---
KC311_DATASET_URL=https://data.kcmo.org/resource/d4px-6rwg.json
# Optional Socrata app token. Raises the rate limit; not required.
KC311_APP_TOKEN=

# --- Timezone ---
# Source timestamps carry no offset. This is the zone they are
# assumed to be recorded in, and the zone every reported date is rendered in.
KC311_SOURCE_TIMEZONE=America/Chicago

# --- Output ---
# The spreadsheet's ID, from its URL: /spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=
# Locally: path to the service account key file.
# In Actions: the key's full JSON, held in a secret.
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Reporting window and files ---
# How many months back the report covers.
KC311_WINDOW_MONTHS=12
# Where raw pulls, cleaned rows and report tables are saved.
KC311_DATA_DIR=./data
